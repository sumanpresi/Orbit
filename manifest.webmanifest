{
  "name": "Orbit — link reminders",
  "short_name": "Orbit",
  "description": "Your links, on your schedule.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#07080d",
  "theme_color": "#07080d",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/badge-96.png", "sizes": "96x96", "type": "image/png", "purpose": "monochrome" }
  ],
  "shortcuts": [
    { "name": "Add link", "url": "./?action=add", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
